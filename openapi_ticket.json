{
  "openapi": "3.0.0",
  "info": {
    "title": "Mock Ticketing MCP API",
    "version": "1.0.0"
  },
  "paths": {
    "/ticket/create": {
      "post": {
        "summary": "Create a governance ticket",
        "description": "Creates a mock governance ticket for access review, access request, or policy violation. Requires high session assurance.",
        "operationId": "createTicket",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "description": "Short description of the ticket, e.g. Access review required for Salesforce Admin."
                  },
                  "user_email": {
                    "type": "string",
                    "description": "Email address of the user the ticket concerns."
                  },
                  "ticket_type": {
                    "type": "string",
                    "enum": ["access_review", "access_request", "violation"],
                    "description": "Governance ticket category."
                  }
                },
                "required": ["subject", "user_email", "ticket_type"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket creation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}