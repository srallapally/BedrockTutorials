{
  "openapi": "3.0.0",
  "info": {
    "title": "Mock Policy MCP API",
    "version": "1.0.0"
  },
  "paths": {
    "/policy/evaluate": {
      "post": {
        "summary": "Evaluate access policy risk",
        "description": "Returns a mock policy risk assessment for a user's entitlement. Requires high session assurance for privileged entitlements.",
        "operationId": "evaluatePolicy",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_email": {
                    "type": "string",
                    "description": "Email address of the user whose entitlement is being evaluated."
                  },
                  "entitlement": {
                    "type": "string",
                    "description": "Entitlement identifier to evaluate, e.g. Salesforce:Admin:Write."
                  }
                },
                "required": ["user_email", "entitlement"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Policy evaluation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}