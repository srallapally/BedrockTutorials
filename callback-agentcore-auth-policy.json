{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCompleteAgentCoreOAuth3LOSession",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:CompleteResourceTokenAuth",
      "Resource": [
        "arn:aws:bedrock-agentcore:${AWS_REGION}:${AWS_ACCOUNT_ID}:token-vault/default",
        "arn:aws:bedrock-agentcore:${AWS_REGION}:${AWS_ACCOUNT_ID}:token-vault/default/oauth2credentialprovider/${OAUTH_PROVIDER_NAME}",
        "arn:aws:bedrock-agentcore:${AWS_REGION}:${AWS_ACCOUNT_ID}:workload-identity-directory/*",
        "arn:aws:bedrock-agentcore:${AWS_REGION}:${AWS_ACCOUNT_ID}:workload-identity-directory/*/workload-identity/${WORKLOAD_IDENTITY_NAME}"
      ]
    }
  ]
}